<launch>
    <include file="$(find am_super)/launch/am_super.launch" />
    <test test-name="auto_to_manual_rostest" pkg="am_super" type="auto_to_manual_rostest" time-limit="20"/>
    <rosparam param="/am_super/manifest">auto_to_manual_rostest</rosparam>
    <rosparam param="/auto_to_manual_rostest/target_node_name">auto_to_manual_rostest</rosparam>
</launch>