<launch>
    <include file="$(find am_super)/launch/am_super.launch" />
    <test test-name="error_status_rostest" pkg="am_super" type="error_status_rostest" time-limit="20"/>
    <rosparam param="/am_super/manifest">error_status_rostest</rosparam>
    <rosparam param="/error_status_rostest/target_node_name">error_status_rostest</rosparam>
</launch>