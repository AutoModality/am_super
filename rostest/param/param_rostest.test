<launch>
  <!-- include test file and pass in this test node name -->
  <include file="$(find am_super)/rostest/am_super_rostest.test">
    <arg name="test_name" value="param_rostest"/>
  </include>
  <rosparam param="/param_rostest/relative">relative_value</rosparam>
  <rosparam param="/some_other_node/absolute">absolute_value</rosparam>
</launch>