<launch>
  <!-- include test file and pass in this test node name -->
  <include file="$(find am_super)/rostest/am_super_rostest.test">
    <arg name="test_name" value="platform_required_pass"/>
  </include>
  <!-- same value for required and actual should pass -->
  <rosparam param="/am_super/platform/required">test</rosparam>
  <rosparam param="/am_super/platform/actual">test</rosparam>
</launch>