<launch>
    <include file="$(find am_super)/launch/am_super.launch" />
    <test test-name="primary_rostest" pkg="am_super" type="primary_rostest" time-limit="20"/>
    <rosparam param="/am_super/manifest">primary_rostest</rosparam>
    <rosparam param="/primary_rostest/target_node_name">primary_rostest</rosparam>
</launch>