<launch>
    <node pkg="am_super" type="am_super" name="am_super" output="screen">
        <rosparam command="load" file="$(dirname)/primary_rostest.yaml"/>
        <param name="init_state" value="UNCONFIGURED"/>
    </node>
    <test test-name="primary_rostest" pkg="am_super" type="primary_rostest" time-limit="20">
        <param name="init_state" value="UNCONFIGURED"/>
    </test>
</launch>