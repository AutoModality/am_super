<launch>
    <node pkg="am_super" type="am_super" name="am_super" output="screen">
        <rosparam command="load" file="$(dirname)/ready_to_shutdown_rostest.yaml"/>
    </node>
    <test test-name="ready_to_shutdown_rostest" pkg="am_super" type="ready_to_shutdown_rostest" time-limit="20">
    </test>
</launch>