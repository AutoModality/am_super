<launch>
    <include file="$(find am_super)/launch/am_super.launch" />
    <test test-name="ready_to_shutdown_rostest" pkg="am_super" type="ready_to_shutdown_rostest" time-limit="20"/>
    <rosparam param="/am_super/manifest">ready_to_shutdown_rostest</rosparam>
    <rosparam param="/ready_to_shutdown_rostest/target_node_name">ready_to_shutdown_rostest</rosparam>
</launch>